# Supabase (Project Settings > API) — use a chave "service_role" (secreta, só aqui no worker!)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Transcrição (Whisper). OpenAI por padrão; para Groq use:
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_API_KEY=

# Escolha dos melhores momentos (Claude). Sem a chave, usa uma heurística simples.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcionais
# CLIP_COUNT=10
# CLIP_MIN_SEC=20
# CLIP_MAX_SEC=75
# YTDLP_COOKIES_FROM_BROWSER=chrome
