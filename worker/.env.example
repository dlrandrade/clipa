# Supabase (Project Settings > API) — use a chave "service_role" (secreta, só aqui no worker!)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Transcrição (Whisper). OpenAI por padrão; para Groq use:
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_API_KEY=

# Escolha dos melhores momentos (Claude). Sem a chave, usa uma heurística simples.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini (Google) — recomendado se não tiver Claude: tem cota gratuita e lê o vídeo inteiro de uma vez.
# Chave em aistudio.google.com/apikey. Atenção: no plano grátis o Google pode usar os dados para melhorar produtos.
GEMINI_API_KEY=
# GEMINI_MODEL=   (opcional; sem ele, usa o "flash" mais novo disponível)

# Alternativa grátis ao Claude: OpenRouter (openrouter.ai/keys).
# O worker descobre os modelos ":free" do momento e troca para o próximo se um falhar.
# Se ANTHROPIC_API_KEY também estiver preenchida, o Claude vai primeiro e o OpenRouter é reserva.
# Limites grátis: ~20 pedidos/min e ~50/dia (1000/dia com US$10 de crédito) — confira em openrouter.ai.
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=modelo-a:free,modelo-b:free   (opcional: fixa a ordem)

# Opcionais
# CLIP_COUNT=10
# CLIP_MIN_SEC=20
# CLIP_MAX_SEC=75
# YTDLP_COOKIES_FROM_BROWSER=chrome
