{
  "name": "clipa-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "cli": "node --env-file-if-exists=.env src/cli.js",
    "test": "node test/api.test.js && node test/pipeline.test.js",
    "test:quick": "node test/api.test.js",
    "autostart": "bash scripts/install-mac-autostart.sh",
    "autostart:off": "bash scripts/uninstall-mac-autostart.sh",
    "logs": "tail -f ~/Library/Logs/clipa-worker.log"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  }
}
